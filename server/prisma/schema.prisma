datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_IN_REVIEW
  TASK_OVERDUE
  SYSTEM
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         Role           @default(DEVELOPER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  ownedProjects Project[]      @relation("ProjectOwner")
  assignedTasks Task[]         @relation("TaskAssignee")
  activityLogs  ActivityLog[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@index([role])
  @@map("users")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  company   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects  Project[]

  @@map("clients")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  clientId    String
  ownerId     String        // The PM who created it, or Admin
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tasks       Task[]
  activityLogs ActivityLog[]

  @@index([ownerId])
  @@index([clientId])
  @@map("projects")
}

model Task {
  id           String        @id @default(uuid())
  taskNumber   Int           @default(autoincrement())
  title        String
  description  String?
  status       TaskStatus    @default(TODO)
  priority     TaskPriority  @default(MEDIUM)
  dueDate      DateTime
  isOverdue    Boolean       @default(false)
  projectId    String
  assignedToId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo   User?         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activityLogs ActivityLog[]
  notifications Notification[]

  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([dueDate, status, isOverdue])
  @@map("tasks")
}

model ActivityLog {
  id             String      @id @default(uuid())
  taskId         String
  projectId      String
  userId         String
  previousStatus TaskStatus?
  newStatus      TaskStatus
  message        String      // E.g. "Ravi moved Task #12 from In Progress -> In Review"
  createdAt      DateTime    @default(now())

  task           Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([taskId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           // Recipient
  taskId    String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revoked, expiresAt])
  @@map("refresh_tokens")
}
