# Environment Configuration Template
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/velozity_db?schema=public

# Authentication Secrets (Generate strong random secrets in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRY=15m

JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long_for_security
JWT_REFRESH_EXPIRY_DAYS=7
COOKIE_SECRET=your_cookie_signing_secret_key_minimum_32_characters
